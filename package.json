{
  "name": "customx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "dev:content": "vite build --config content.vite.config.ts --watch",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && npm run build:main && npm run build:content",
    "build:main": "vite build",
    "build:content": "vite build --config content.vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
